<mvc:View controllerName="com.axium.Axium.controller.QRScan" xmlns:mvc="sap.ui.core.mvc" displayBlock="true" xmlns:core="sap.ui.core"
	xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" xmlns:ndc="sap.ndc" xmlns:fiori="sap.ui.webc.fiori" xmlns="sap.m">
	<Page title="QR Physical Inventory" showNavButton="true" navButtonPress="onBack">
		<HBox>
			<ndc:BarcodeScannerButton scanSuccess="onScanSuccess" scanFail="onScanError" inputLiveUpdate="onScanLiveupdate"
				dialogTitle="Barcode Scanner Button Sample" width="5rem"/>
			<VBox class="sapUiSmallMargin">
				<f:SimpleForm columnsL="7" columnsM="7" editable="false" emptySpanL="1" emptySpanM="1" labelSpanL="4" labelSpanM="4"
					layout="ResponsiveGridLayout" maxContainerCols="2" minWidth="1024">
					<f:content>
						<Label text="Bin Number" design="Bold" width="100%" textAlign="Begin" textDirection="Inherit" visible="true"></Label>
						<Input id="binNumber" required="true" value="" placeholder="Please Scan Bin Number" change="onBinValidation"></Input>
						<Label text="Plant" design="Bold" width="100%" textAlign="Begin" textDirection="Inherit" visible="true"></Label>
						<Input id="plant" required="true" value="{scanResultModel>/Plant}" placeholder="Please Scan Material" change="onMaterialValidate"></Input>
						<Label text="Storage Location" design="Bold" width="100%" textAlign="Begin" textDirection="Inherit" visible="true"></Label>
						<Input id="storageLoc" required="true" value="{scanResultModel>/StorageLoc}" placeholder="Please Scan Material"></Input>
						<Label text="Material" design="Bold" width="100%" textAlign="Begin" textDirection="Inherit" visible="true"></Label>
						<Input id="matNumber" required="true" value="{scanResultModel>/Material}" placeholder="Please Scan Material"></Input>
						<Label text="Material Description" design="Bold" width="100%" textAlign="Begin" textDirection="Inherit" visible="true"></Label>
						<Input id="materialDesc" required="true" enabled="false" editable="false"/>
						<Label text="Batch Number" design="Bold" width="100%" textAlign="Begin" textDirection="Inherit" visible="true"></Label>
						<Input id="BatchNumber" value="{scanResultModel>/BatchNum}" placeholder="Enter Batch Number" maxLength="10"/>
						<Label id="BoxLbl" text="Box" design="Bold" width="100%" textAlign="Begin" textDirection="Inherit" visible="{PYIMListLocalModel>/bNotRM01}"></Label>
						<Input id="Box" value="{scanResultModel>/StorageLoc}" placeholder="Enter Boxes" maxLength="5" type="Number"
							visible="{PYIMListLocalModel>/bNotRM01}"/>
						<Label id="Quan" text="Quantity/Pallets" design="Bold" width="100%" textAlign="Begin" textDirection="Inherit"
							visible="{PYIMListLocalModel>/bNotRM01}"></Label>
						<Input id="Quantity" value="{scanResultModel>/Quantity}" placeholder="Enter Quantity/pallets" visible="{PYIMListLocalModel>/bNotRM01}"/>
						<Input id="UOM" value="" required="true" enabled="false" visible="false" placeholder="UOM">
							<layoutData>
								<l:GridData span="L2 M4 S6"/>
							</layoutData>
						</Input>
					</f:content>
				</f:SimpleForm>
				<f:SimpleForm columnsL="4" columnsM="4" editable="false" emptySpanL="4" emptySpanM="4" labelSpanL="4" labelSpanM="4"
					layout="ResponsiveGridLayout" maxContainerCols="1" minWidth="1024">
					<f:content>
						<Label text="Boxes" design="Bold" width="100%" textAlign="Begin" textDirection="Inherit"/>
						<Table id="idBoxTable" inset="false" items="{oBoxQtyModel>/oBoxListSet}" visible="{PYIMListLocalModel>/bRM01}">
							<headerToolbar>
								<OverflowToolbar>
									<content>
										<ToolbarSpacer/>
										<Button id="idBoxAdd" text="Add Box" width="40%" icon="sap-icon://add" type="Emphasized" press="onAddBox"></Button>
									</content>
								</OverflowToolbar>
							</headerToolbar>
							<columns>
								<Column width="7em">
									<Text text="Box"/>
								</Column>
								<Column minScreenWidth="Tablet" demandPopin="true" width="12em">
									<Text text="Quantity"/>
								</Column>
								<Column minScreenWidth="Tablet" demandPopin="true" width="3em">
									<Text text=""/>
								</Column>
							</columns>
							<items>
								<ColumnListItem>
									<cells>
										<Input value="{oBoxQtyModel>iBox}" editable="false" placeholder="Enter Boxes" maxLength="5" type="Number"/>
										<Input value="{oBoxQtyModel>iQuantity}" required="true" placeholder="Enter Quantity/Pallets"/>
										<core:Icon src="sap-icon://decline" press="onPressBoxDel"></core:Icon>
									</cells>
								</ColumnListItem>
							</items>
						</Table>
					</f:content>
				</f:SimpleForm>
				<List items="{PYIMListModel>/PYIMListSet}" headerText="Materials" mode="MultiSelect" id="idList">
					<items>
						<ObjectListItem title="{PYIMListModel>BinNumber}" id="id6">
							<attributes>
								<ObjectAttribute title="Material" text="{PYIMListModel>MaterialNumber}"/>
								<ObjectAttribute title="Material Description" text="{PYIMListModel>MaterialDescription}"/>
								<ObjectAttribute title="Batch Number" text="{PYIMListModel>Batch}"/>
								<ObjectAttribute title="Box" text="{PYIMListModel>BoxID}"/>
								<ObjectAttribute title="Quantity/Pallets" text="{PYIMListModel>Quantity}"/>
							</attributes>
						</ObjectListItem>
					</items>
					<headerToolbar>
						<OverflowToolbar>
							<Title text="Materials" level="H2"/>
							<ToolbarSpacer/>
							<Button id="idMatAdd" text="Add Material" width="20%" icon="sap-icon://add" type="Emphasized" press="onAddMaterial"></Button>
						</OverflowToolbar>
					</headerToolbar>
				</List>
			</VBox>
		</HBox>
		<footer>
			<Bar>
				<contentRight>
					<Button text="Submit" type="Accept" icon="sap-icon://save" press="onSave" enabled="true"/>
				</contentRight>
				<contentLeft>
					<Button text="Delete" type="Reject" icon="sap-icon://delete" press="onDelete"/>
				</contentLeft>
			</Bar>
		</footer>
	</Page>
</mvc:View>