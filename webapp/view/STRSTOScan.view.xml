<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" controllerName="com.axium.Axium.controller.STRSTOScan"
	xmlns:html="http://www.w3.org/1999/xhtml" xmlns:tnt="sap.tnt">
	<App>
		<pages>
			<Page>
				<tnt:InfoLabel text="SELECT MATERIAL TO SCAN HU's" colorScheme="3" renderMode="Narrow"></tnt:InfoLabel>
				<customHeader>
					<Bar>
						<contentRight>
							<Input id="doorid" enabled="false" placeholder="Please Scan Door No" liveChange="doorValidation"></Input>
						</contentRight>
						<contentMiddle>
							<Label text="Stock Transfer Receipts For Inbound Deliveries"></Label>
						</contentMiddle>
						<contentLeft>
							<Button icon="sap-icon://nav-back" press="onPressBack"/>
						</contentLeft>
					</Bar>
				</customHeader>
				<content>
					<ScrollContainer id="oScroll" height="500px" vertical="true" focusable="true">
						<Table enableBusyIndicator="true" items="{STRSTOInboundDelivery>/results}" mode="SingleSelectMaster" selectionChange="onSTRMaterial"
							id="idSTRMaterials" growing="true">
							<columns>
								<Column hAlign="Center" width="60px" demandPopin="true">
									<Label text="Material Description" design="Bold"></Label>
								</Column>
								<Column hAlign="Center" width="60px" demandPopin="true">
									<Label text="Material Number" design="Bold"></Label>
								</Column>
								<Column hAlign="Center" width="60px" demandPopin="true">
									<Label text="Quanity" design="Bold"></Label>
								</Column>
								<Column hAlign="Center" width="60px" demandPopin="true">
									<Label text="Unit of Measure" design="Bold"></Label>
								</Column>
								<Column hAlign="Center" width="60px" demandPopin="true">
									<Label text="Total Pallets" design="Bold"></Label>
								</Column>
								<Column hAlign="Center" width="60px" demandPopin="true">
									<Label text="Scanned Pallets" design="Bold"></Label>
								</Column>
							</columns>
							<items>
								<ColumnListItem>
									<cells>
										<Text text="{STRSTOInboundDelivery>MaterialNumber}"></Text>
										<Text text="{STRSTOInboundDelivery>MaterialDescription}"></Text>
										<Text text="{STRSTOInboundDelivery>Quantity}"></Text>
										<Text text="{STRSTOInboundDelivery>UOM}"></Text>
										<Text text="{STRSTOInboundDelivery>ScannedPallet}"></Text>
										<Text text="{STRSTOInboundDelivery>TotalPallet}"></Text>
									</cells>
								</ColumnListItem>
							</items>
						</Table>
					</ScrollContainer>
				</content>
			</Page>
		</pages>
	</App>
</mvc:View>