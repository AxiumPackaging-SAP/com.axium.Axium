						</Table>-->
					<!--</ScrollContainer>-->
				</content>
				<footer>
					<Bar>
						<contentRight>
							<!--<Button text="Submit" press="onInvenSubmit" type="Accept"/>-->
							<Button text="Hold" id="HO" visible="{huAction>/huRelVisib}" type="Accept" press="onHold"/>
							<Button text="Release" id="RE" visible="{huAction>/huHoldVisib}" type="Accept" press="onrel"/>
							<Button text=" " type="Reject" icon="sap-icon://delete" press="onDelete"/>
							<Button text="Call Release" id="rel" visible="{huAction>/huRelVisib}" type="Reject" press="goToRel"/>
							<Button text="Call Hold" id="hold" visible="{huAction>/huHoldVisib}" type="Reject" press="goToHold"/>
						</contentRight>
					</Bar>
				</footer>
			</Page>
		</pages>
	</App>
</mvc:View>